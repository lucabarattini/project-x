# Copy to .env.local and fill in. .env* is gitignored — never commit real values.

# Apify account token. Grants full read/write to the account below.
APIFY_TOKEN=

# Named key-value store that holds the HIRING_POSTS_FEED record.
APIFY_STORE_ID=

# Saved Apify task whose input the ingest webhook rotates between company batches.
APIFY_TASK_ID=

# Shared secret for the machine endpoints: POST /api/hiring-posts/ingest (the
# Apify run-succeeded webhook) and POST /api/hiring-posts/refresh.
HIRING_POSTS_WEBHOOK_SECRET=

# Unlocks the hiring-signal feed for a human viewer at
# /api/hiring-posts/unlock?key=<value>. Leave EMPTY to keep signals private:
# with no key set, nobody — including you — can read the feed over HTTP.
# Use a different value from HIRING_POSTS_WEBHOOK_SECRET so sharing read access
# never hands out ingest access.
HIRING_POSTS_VIEW_KEY=

# Optional: results per search query per run (default 10, hard cap 50).
# The actor applies this PER QUERY, so cost scales with query count x this value.
HIRING_POSTS_MAX_POSTS=
